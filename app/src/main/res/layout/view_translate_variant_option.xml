<?xml version="1.0" encoding="utf-8"?>
<!--
  One row inside TranslateLayoutSettingsFragment's cover/Flex RadioGroups -
  a RadioButton (title) plus a subtitle line underneath. RadioGroup manages
  mutual exclusivity by walking its view tree looking for RadioButton
  descendants (see RadioGroup.PassThroughHierarchyChangeListener), so nesting
  the RadioButton one level inside this wrapper still works correctly - it
  does not need to be a direct child of the RadioGroup.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <RadioButton
        android:id="@+id/radioOption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textOptionSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:textSize="13sp"
        android:alpha="0.75" />

</LinearLayout>
