<?xml version="1.0" encoding="utf-8"?>
<!--
  Flex-Mode (tabletop) variant "loop_compare" (Practice tab, ScreenMode.FLEX).
  Above the hinge (paneLoopViewing): the primary Start/Stop toggle plus two
  icon indicators (iconLoopReference/iconLoopMine) that highlight whichever
  side is currently sounding - PracticeFragment.runLoopCompare literally
  resequences the SAME hearReference()/playFile() calls every other layout
  in this tab uses, chained back-to-back via their existing onDone
  callbacks, per the variant's brief ("icon-first, built from existing
  TTS/playback pieces resequenced" - no new audio pipeline). Below the hinge
  (paneLoopControl): the same language/gender/phrase/record controls as
  flex_default's control pane, inlined here (not shared via <include> - see
  PracticeFragment's doc comment on why each Flex variant in this codebase
  owns its own control content rather than two variants sharing one binding).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLoopCompare"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <ScrollView
        android:id="@+id/paneLoopControl"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <Spinner
                android:id="@+id/spinnerLoopLang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <RadioGroup
                android:id="@+id/radioGroupLoopGender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <RadioButton
                    android:id="@+id/radioLoopFemale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="♀ Female" />

                <RadioButton
                    android:id="@+id/radioLoopMale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="♂ Male" />
            </RadioGroup>

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editLoopPhrase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Word or phrase to practice"
                android:inputType="textCapSentences" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/btnLoopRecord"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Record my attempt"
                    android:src="@android:drawable/ic_btn_speak_now" />

                <TextView
                    android:id="@+id/textLoopMicStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:textSize="11sp"
                    android:textStyle="italic" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/paneLoopViewing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?android:attr/colorBackground"
        android:padding="16dp">

        <TextView
            android:id="@+id/textLoopPhrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="18sp"
            android:text="Type a phrase below" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/iconLoopReference"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:textSize="22sp"
                android:background="@drawable/bg_chip_outline"
                android:text="🔊" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:textSize="16sp"
                android:text="⇄" />

            <TextView
                android:id="@+id/iconLoopMine"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:textSize="22sp"
                android:background="@drawable/bg_chip_outline"
                android:text="🎙" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/btnLoopToggle"
            android:layout_width="120dp"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/colorPrimary">

            <TextView
                android:id="@+id/textLoopToggleLabel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:text="▶ Start loop" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/textLoopStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textStyle="italic" />

    </LinearLayout>

</FrameLayout>
