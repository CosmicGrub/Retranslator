<?xml version="1.0" encoding="utf-8"?>
<!--
  One row of the "multi_broadcast" Flex-Mode variant's viewing pane -
  one target language's latest broadcast result, with its own play-TTS
  button. Inflated programmatically per roster entry by
  TranslateFragment.refreshBroadcastRows (list size is small - a handful of
  target languages - so a plain LinearLayout of these, rebuilt on every
  change, is the same complexity/scale precedent as
  ConversationsFragment.refreshRecordingsList already uses; no RecyclerView
  needed).
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textBroadcastLang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="Spanish" />

            <TextView
                android:id="@+id/textBroadcastResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="15sp"
                android:text="—" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnBroadcastPlay"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Play"
            android:src="@android:drawable/ic_lock_silent_mode_off" />

        <ImageButton
            android:id="@+id/btnBroadcastRemove"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Remove from roster"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
