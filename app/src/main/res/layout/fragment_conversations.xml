<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conversations"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:text="Hand the device back and forth: tap the mic, speak, and it auto-translates and speaks aloud in the other person's language. Download packs for these languages on the Translate tab first."
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Spinner
                android:id="@+id/spinnerLangA"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  ⇄  "
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/spinnerLangB"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <RadioGroup
            android:id="@+id/radioGroupGenderConv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <RadioButton
                android:id="@+id/radioFemaleConv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♀ Female voice"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioMaleConv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="♂ Male voice" />
        </RadioGroup>

        <TextView
            android:id="@+id/textTurnIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="Person A's turn" />

        <Button
            android:id="@+id/btnConversationMic"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="Tap to speak" />

        <ToggleButton
            android:id="@+id/toggleContinuousListening"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textOn="Continuous listening on (auto-detects language, no tap needed - tap to stop)"
            android:textOff="Continuous listening (no tap needed, auto-detects language)"
            android:checked="false" />

        <TextView
            android:id="@+id/textConversationStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="12sp"
            android:textStyle="italic" />

        <ToggleButton
            android:id="@+id/toggleRecordSession"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textOn="Recording this conversation (tap to stop)"
            android:textOff="Record this conversation"
            android:checked="false" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Transcript"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textTranscript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="80dp"
            android:background="#11000000"
            android:padding="8dp"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:text="" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Saved recordings"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/recordingsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp" />

    </LinearLayout>
</ScrollView>
