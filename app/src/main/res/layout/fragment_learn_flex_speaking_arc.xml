<?xml version="1.0" encoding="utf-8"?>
<!--
  Flex-Mode variant "speaking_arc" (Learn tab). Only the speaking exercise
  gets the bespoke arc control row (containerArcSpeaking) - every other
  exercise type in this variant falls back to the same standard
  viewing/control chrome flex_default uses (containerArcStandardDynamic +
  btnArcStandardContinue), toggled by LearnFragment.bindSpeakingArc per the
  active exercise's type. Top pane feedback is icon-only (imageArcFeedback,
  checkmark/x, no score/percentage) - the prompt phrase itself is not
  "feedback" and stays as plain text above it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootSpeakingArc"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Top ("viewing") pane -->
    <LinearLayout
        android:id="@+id/paneArcTop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <TextView
            android:id="@+id/textArcPrompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!--
          contentDescription is intentionally NOT a static "Result" label -
          it's the one piece of information this icon exists to convey
          (correct vs incorrect), so LearnFragment.showArcFeedbackIcon sets
          it to the real per-attempt outcome every time this becomes
          visible. The XML default below is only what would show if some
          future path made this visible without going through that
          function; renderArcExercise also resets it back to this neutral
          text whenever the icon is hidden again for a new exercise.
        -->
        <ImageView
            android:id="@+id/imageArcFeedback"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:visibility="invisible"
            android:contentDescription="Result not yet available" />

        <TextView
            android:id="@+id/textArcStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textSize="12sp"
            android:alpha="0.7" />
    </LinearLayout>

    <!-- Bottom ("control") pane -->
    <FrameLayout
        android:id="@+id/paneArcBottom"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- speaking-only: bespoke arc row -->
        <LinearLayout
            android:id="@+id/containerArcSpeaking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="12dp">

            <ImageButton
                android:id="@+id/btnArcReplayTarget"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_chip_outline"
                android:contentDescription="Hear the target phrase"
                android:src="@android:drawable/ic_lock_silent_mode_off" />

            <ImageButton
                android:id="@+id/btnArcRecord"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_chip_filled"
                android:contentDescription="Record"
                android:src="@android:drawable/ic_btn_speak_now"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/btnArcReplayMine"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginHorizontal="10dp"
                android:background="@drawable/bg_chip_outline"
                android:contentDescription="Hear my attempt"
                android:src="@android:drawable/ic_media_play" />

            <ImageButton
                android:id="@+id/btnArcSkip"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginHorizontal="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Skip"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />
        </LinearLayout>

        <!-- non-speaking fallback: same standard dynamic container/continue as flex_default -->
        <ScrollView
            android:id="@+id/scrollArcStandard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:id="@+id/containerArcStandardDynamic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <Button
                    android:id="@+id/btnArcStandardContinue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Continue"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

    </FrameLayout>

</FrameLayout>
