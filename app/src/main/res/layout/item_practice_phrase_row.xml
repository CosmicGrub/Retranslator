<?xml version="1.0" encoding="utf-8"?>
<!--
  One row in the "drill_deck" cover variant's phrase queue
  (PracticeFragment.refreshDrillDeckContent). Inline hear/record controls
  plus an attempted-this-session marker dot, per that variant's brief -
  reused, not mocked: btnPhraseRowHear/btnPhraseRowRecord drive the exact
  same hearReference()/toggleRecordAttempt() functions every other layout
  uses, just once per queued phrase instead of once for a single field.
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/textPhraseRowAttemptedDot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="●"
            android:textColor="?attr/colorAccent"
            android:textSize="12sp"
            android:visibility="invisible"
            android:contentDescription="Attempted this session" />

        <TextView
            android:id="@+id/textPhraseRowText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="14sp"
            android:text="Phrase text" />

        <ImageButton
            android:id="@+id/btnPhraseRowHear"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Hear reference"
            android:src="@android:drawable/ic_lock_silent_mode_off" />

        <ImageButton
            android:id="@+id/btnPhraseRowRecord"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Record my attempt"
            android:src="@android:drawable/ic_btn_speak_now" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
