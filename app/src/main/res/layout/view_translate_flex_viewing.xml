<?xml version="1.0" encoding="utf-8"?>
<!--
  "Viewing" pane content - the half of a Flex-Mode (tabletop) layout that
  sits ABOVE the hinge, per this project's established Flex Mode pattern
  (results/output above, controls below). Used by "flex_default" only -
  "multi_broadcast" has its own scrollable per-target-language roster view
  instead of a single result, so it does not reuse this file.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <TextView
            android:id="@+id/textFlexDetected"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="12sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/textFlexResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textSize="22sp"
            android:text="Your translation will appear here." />

        <ImageButton
            android:id="@+id/btnFlexSpeak"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Speak translation"
            android:src="@android:drawable/ic_lock_silent_mode_off" />
    </LinearLayout>
</ScrollView>
