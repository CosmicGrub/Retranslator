<?xml version="1.0" encoding="utf-8"?>
<!--
  Cover-screen variant "drill_carousel" (Practice tab, ScreenMode.COVER).
  One phrase card at a time (cardCarouselPhrase), swiped left/right via a
  touch listener on the card itself (same hold/swipe touch-state-machine
  technique TranslateFragment.bindSingleCircle already established in this
  codebase - see PracticeFragment.bindDrillCarousel). btnCarouselAction is
  one big center circular button (circle-via-CardView, same technique as
  Translate's "single_circle") that cycles hear-reference -> record ->
  hear-mine on repeated taps - see PracticeFragment's CarouselStep doc
  comment for the exact tap sequence (recording genuinely needs a
  start-tap and a stop-tap, so this is not a literal single-tap-per-state
  cycle). rowCarouselDots are plain pager dots, one per queued phrase.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editCarouselAddPhrase"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:hint="Add a phrase…"
            android:inputType="textCapSentences"
            android:maxLines="1" />

        <ImageButton
            android:id="@+id/btnCarouselAddPhrase"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Add phrase"
            android:src="@android:drawable/ic_input_add" />
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardCarouselPhrase"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="3dp"
        app:layout_constraintTop_toBottomOf="@id/editCarouselAddPhrase"
        app:layout_constraintBottom_toTopOf="@id/rowCarouselDots"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="150dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp">

            <TextView
                android:id="@+id/textCarouselPhrase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="17sp"
                android:text="No phrases yet - add one above" />

            <androidx.cardview.widget.CardView
                android:id="@+id/btnCarouselAction"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="38dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/colorPrimary">

                <TextView
                    android:id="@+id/textCarouselActionIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:text="🔊" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/textCarouselStepHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textSize="11sp"
                android:alpha="0.75"
                android:text="Tap to hear the reference" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/rowCarouselDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
