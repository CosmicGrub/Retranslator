<?xml version="1.0" encoding="utf-8"?>
<!--
  Local diagnostics journal viewer - docs/specs/engineering-systems-pitch.md
  system #5. Reachable from Settings hub. Lists the most recent entries from
  com.retroid.translator.diagnostics.DiagnosticsStore (warnings, errors, and
  any folded-in crash record from the previous run) and offers a "Share
  diagnostic log" export via FileProvider. Events list is built in code
  (DiagnosticsFragment, matching this codebase's existing buildListRow
  precedent in LearnFragment/ManagePacksFragment) into listEvents below,
  since the row count is data-driven, not fixed.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="2dp"
            app:cardCornerRadius="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textDiagnosticsSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:text="Checking diagnostics log…" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="12sp"
                    android:alpha="0.7"
                    android:text="Kept only on this device - never uploaded anywhere. Entries record error types and technical details only, never translated or recognized speech content." />

                <Button
                    android:id="@+id/btnShareDiagnosticsLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Share diagnostic log…" />

                <Button
                    android:id="@+id/btnClearDiagnosticsLog"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Clear log" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/textNoEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="14sp"
            android:alpha="0.7"
            android:text="No diagnostic events recorded yet."
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/listEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
