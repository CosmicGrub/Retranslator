<?xml version="1.0" encoding="utf-8"?>
<!--
  One "side" of the tabletop-landscape mirrored Conversations layout (spec
  §2). fragment_conversations_mirrored.xml includes this twice - once as-is
  (the pane below the hinge) and once with android:rotation="180" applied to
  its root at runtime (the pane above the hinge), so each person reads their
  own half right-side up. Both instances are driven by the exact same
  turn/transcript state as the fallback fragment_conversations.xml - this is
  a new presentation of existing data, not new state.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/textPaneTurnIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="14sp"
        android:textStyle="bold"
        android:text="Person A's turn" />

    <!--
      One row per transcript turn belonging to this pane (docs/specs/fold5-adaptation.md
      §4's tap-to-fix reassign affordance - see TranscriptAdapter/
      item_transcript_bubble.xml), newest first, scrolled to position 0 on
      every update (see ConversationsFragment.refreshTranscriptViews) - the
      edge nearest the physical hinge for both panes (this pane's own top
      edge sits at the hinge; the other pane's local "top" ends up at the
      hinge too once it's rotated 180° about its own center, per spec §2's
      "largest/most recent nearest the hinge"). Replaces what used to be a
      ScrollView wrapping one growing TextView - a RecyclerView scrolls
      itself, so the outer ScrollView is gone too.
    -->
    <!--
      accessibilityLiveRegion="polite" (not "assertive"): new turns arriving
      during continuous listening should be announced to TalkBack without
      interrupting whatever the user is currently doing/hearing.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPaneTranscript"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:accessibilityLiveRegion="polite" />

    <TextView
        android:id="@+id/textPaneStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="11sp"
        android:textStyle="italic" />

    <Button
        android:id="@+id/btnPaneMic"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:text="Tap to speak" />

    <ToggleButton
        android:id="@+id/togglePaneContinuous"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="10sp"
        android:textOn="Continuous on (tap to stop)"
        android:textOff="Continuous listening"
        android:checked="false" />

</LinearLayout>
