<?xml version="1.0" encoding="utf-8"?>
<!--
  One row inside LearnLayoutSettingsFragment's cover/Flex RadioGroups - a
  RadioButton (title) plus a subtitle line underneath. Same structure as
  view_translate_variant_option.xml (read for the pattern, not modified) -
  RadioGroup finds RadioButton descendants anywhere in its tree, so nesting
  one level inside this wrapper still works correctly.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <RadioButton
        android:id="@+id/radioOption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textOptionSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:textSize="13sp"
        android:alpha="0.75" />

</LinearLayout>
