<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:text="Per-tab layout, cover screen and Flex Mode (tabletop)"
            android:textSize="13sp"
            android:textStyle="italic" />

        <LinearLayout
            android:id="@+id/rowTranslateLayout"
            style="@style/SettingsHubRow">
            <TextView
                style="@style/SettingsHubRowTitle"
                android:text="Translate layout" />
            <TextView
                style="@style/SettingsHubRowSubtitle"
                android:text="Cover-screen and Flex Mode layout for the Translate tab" />
        </LinearLayout>

        <View style="@style/SettingsHubDivider" />

        <LinearLayout
            android:id="@+id/rowPracticeLayout"
            style="@style/SettingsHubRow">
            <TextView
                style="@style/SettingsHubRowTitle"
                android:text="Practice layout" />
            <TextView
                style="@style/SettingsHubRowSubtitle"
                android:text="Cover-screen and Flex Mode layout for the Practice tab" />
        </LinearLayout>

        <View style="@style/SettingsHubDivider" />

        <LinearLayout
            android:id="@+id/rowLearnLayout"
            style="@style/SettingsHubRow">
            <TextView
                style="@style/SettingsHubRowTitle"
                android:text="Learn layout" />
            <TextView
                style="@style/SettingsHubRowSubtitle"
                android:text="Cover-screen and Flex Mode layout for the Learn tab" />
        </LinearLayout>

        <!-- Tab S9 FE edition (docs/specs/galaxy-tab-s9fe-adaptation.md,
             "Edition build" section): the "Fold behavior" row (auto-switch-
             on-fold / force-compact toggles) was removed here on purpose -
             this device has no hinge, so those switches control behavior
             that can never apply on this hardware. FoldBehaviorFragment.kt
             and fragment_fold_behavior.xml were deleted along with this
             entry point; see that spec section for the reachability trace
             confirming nothing else referenced them. -->

        <View style="@style/SettingsHubDivider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:text="Storage"
            android:textSize="13sp"
            android:textStyle="italic" />

        <LinearLayout
            android:id="@+id/rowLanguagePacks"
            style="@style/SettingsHubRow">
            <TextView
                style="@style/SettingsHubRowTitle"
                android:text="Language packs" />
            <TextView
                style="@style/SettingsHubRowSubtitle"
                android:text="Download, delete, and check for updates on translation, voice-input, and natural-voice packs" />
        </LinearLayout>

        <View style="@style/SettingsHubDivider" />

    </LinearLayout>
</ScrollView>
