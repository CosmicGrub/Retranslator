<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!--
          tab-s9fe-device-version branch: this build targets the Galaxy Tab
          S9 FE specifically, a device with no hinge and no FoldingFeature at
          all (docs/specs/galaxy-tab-s9fe-adaptation.md §3: "this tablet has
          no hinge... None of that was ported"). The four rows below - the
          per-tab Cover/Flex-Mode variant pickers and the fold auto-
          switch/force-compact toggle - are structurally inert on this
          device: COVER mode requires physically folding closed, FLEX mode
          requires a real tabletop FoldingFeature posture, and neither can
          ever occur on hardware with no hinge to begin with. Rather than
          leave a user free to navigate into four settings screens that can
          never have any visible effect on this build, they're hidden here.
          Nothing in SettingsHubFragment.kt needed to change - a gone view's
          click listener simply never fires.
        -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:text="Per-tab layout, cover screen and Flex Mode (tabletop)"
            android:textSize="13sp"
            android:textStyle="italic"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/rowTranslateLayout"
            style="@style/SettingsHubRow"
            android:visibility="gone">
            <TextView
                style="@style/SettingsHubRowTitle"
                android:text="Translate layout" />
            <TextView
                style="@style/SettingsHubRowSubtitle"
                android:text="Cover-screen and Flex Mode layout for the Translate tab" />
        </LinearLayout>

        <View style="@style/SettingsHubDivider" android:visibility="gone" />

        <LinearLayout
            android:id="@+id/rowPracticeLayout"
            style="@style/SettingsHubRow"
            android:visibility="gone">
            <TextView
                style="@style/SettingsHubRowTitle"
                android:text="Practice layout" />
            <TextView
                style="@style/SettingsHubRowSubtitle"
                android:text="Cover-screen and Flex Mode layout for the Practice tab" />
        </LinearLayout>

        <View style="@style/SettingsHubDivider" android:visibility="gone" />

        <LinearLayout
            android:id="@+id/rowLearnLayout"
            style="@style/SettingsHubRow"
            android:visibility="gone">
            <TextView
                style="@style/SettingsHubRowTitle"
                android:text="Learn layout" />
            <TextView
                style="@style/SettingsHubRowSubtitle"
                android:text="Cover-screen and Flex Mode layout for the Learn tab" />
        </LinearLayout>

        <View style="@style/SettingsHubDivider" android:visibility="gone" />

        <LinearLayout
            android:id="@+id/rowFoldBehavior"
            style="@style/SettingsHubRow"
            android:visibility="gone">
            <TextView
                style="@style/SettingsHubRowTitle"
                android:text="Fold behavior" />
            <TextView
                style="@style/SettingsHubRowSubtitle"
                android:text="Auto-switch on fold, and a manual compact-layout toggle" />
        </LinearLayout>

        <View style="@style/SettingsHubDivider" android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:text="Storage"
            android:textSize="13sp"
            android:textStyle="italic" />

        <LinearLayout
            android:id="@+id/rowLanguagePacks"
            style="@style/SettingsHubRow">
            <TextView
                style="@style/SettingsHubRowTitle"
                android:text="Language packs" />
            <TextView
                style="@style/SettingsHubRowSubtitle"
                android:text="Download, delete, and check for updates on translation, voice-input, and natural-voice packs" />
        </LinearLayout>

        <View style="@style/SettingsHubDivider" />

    </LinearLayout>
</ScrollView>
