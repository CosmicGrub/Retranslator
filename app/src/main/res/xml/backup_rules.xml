<?xml version="1.0" encoding="utf-8"?>
<!--
  Legacy backup-exclusion rules (android:fullBackupContent), used on API
  23-30. Superseded by data_extraction_rules.xml on API 31+, but this app's
  minSdk is 28, so both are needed to actually cover the supported range -
  declaring only dataExtractionRules would silently leave API 28-30 devices
  unprotected.

  Excludes: recordings/ (real user/conversation-partner voice audio -
  RecordingsStore.kt writes here; this is the actual privacy-sensitive data
  behind this file's existence, not the other two, which are excluded for
  backup-quota/no-value-preserving reasons instead), vosk-models/ and
  piper-voices/ (large, fully re-downloadable model packs - no privacy
  content, but no reason to consume backup quota on multi-hundred-MB files
  that download fresh on any new device anyway), and diagnostics/ (local
  crash/error journal - com.retroid.translator.diagnostics.DiagnosticsStore/
  CrashHandler; reviewed and confirmed it only ever logs metadata - voice
  IDs, language codes, URLs, exception messages - never translated/
  recognized/conversation text, but it's still ephemeral device-local debug
  data with no reason to follow the user to a new device or a cloud backup),
  backup_safety_net/ (internal pre-import snapshots
  com.retroid.translator.backup.BackupManager writes before an import - the
  user's own real backup files are wherever they chose to save/pick them
  via Storage Access Framework, not here; these are a same-device-only
  undo net, redundant to sync anywhere else), and the learn_progress.db
  database itself (see below): now that system #7's Local Data Vault gives
  the user a deliberate, visible, versioned way to back this up themselves,
  relying on silent OS Auto Backup for the same data is no longer the only
  path and is inconsistent with this app's own stated "nothing happens
  invisibly" stance - a real product decision, not an omission the way its
  absence here used to be.
-->
<full-backup-content>
    <exclude domain="file" path="recordings/" />
    <exclude domain="file" path="vosk-models/" />
    <exclude domain="file" path="piper-voices/" />
    <exclude domain="file" path="diagnostics/" />
    <exclude domain="file" path="backup_safety_net/" />
    <exclude domain="database" path="learn_progress.db" />
</full-backup-content>
