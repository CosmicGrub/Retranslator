<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed only for the one-time ML Kit / Vosk / natural-voice (Piper via
         sherpa-onnx) language-pack downloads; all translation, speech
         recognition and speech synthesis after that runs fully offline,
         on-device, with no ongoing network dependency. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Mic capture for offline Vosk speech-to-text and for the Conversations /
         Practice recording features. Requested at runtime as well (dangerous
         permission). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Wake-lock reliability fix (docs/specs/fold5-adaptation.md §4): scoped
         ONLY to Conversations' continuous-listening mode (ContinuousListeningService),
         acquired/released around that session, never a blanket always-on lock
         for the app. WAKE_LOCK backs the PARTIAL_WAKE_LOCK that keeps the CPU
         scheduled for the mic-capture/VAD/dual-recognizer-decode threads
         through a screen lock; FOREGROUND_SERVICE + FOREGROUND_SERVICE_MICROPHONE
         are required by Android 14 (this project's targetSdk) to run a
         foreground service that keeps capturing microphone audio once the
         app is no longer in the foreground - without the microphone-typed
         foreground service, the OS can refuse to deliver mic audio at all
         once backgrounded, independent of any battery-management killing.
         POST_NOTIFICATIONS lets that foreground service's persistent
         "Listening for conversation..." notification actually display on
         Android 13+ (the service itself still runs without it, but the
         honest visible indicator - the whole reason a foreground service
         was chosen over a silent wake lock - would silently not show). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".TranslatorApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.RetroidTranslator">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Throwaway debug-only prototype for docs/specs/fold5-adaptation.md §4
             (dual-recognizer parallel Vosk decoding spike). Not linked from any
             nav flow (MainActivity/BottomNavigationView never reference it) —
             trigger directly with:
             adb shell am start -n com.retroid.translator/.prototype.DualRecognizerProtoActivity
             exported=true only because Android 16 (confirmed on-device, API 36,
             security patch 2026-06-05) blocks `adb shell am start` of a
             non-exported activity even in a debuggable app - a hardening change
             from what used to be a standard debug workflow. There is no other
             way to trigger a non-exported activity from adb on this OS version;
             it stays out of the launcher and out of every shipped nav flow. -->
        <activity
            android:name=".prototype.DualRecognizerProtoActivity"
            android:exported="true"
            android:label="Dual Recognizer Prototype (debug)" />

        <!-- Throwaway debug entry point validating the continuous-listening
             pipeline (VAD -> dual-recognizer -> early guess -> translate ->
             TTS, docs/specs/fold5-adaptation.md §4 wired into
             ConversationsFragment) against real recorded human speech.
             Same exported=true rationale as DualRecognizerProtoActivity
             above (Android 16 blocks `adb shell am start` of a non-exported
             activity even in a debuggable app). Trigger:
             adb shell am start -n com.retroid.translator/.prototype.ContinuousFlowProtoActivity
             Not linked from any nav flow, off the launcher. -->
        <activity
            android:name=".prototype.ContinuousFlowProtoActivity"
            android:exported="true"
            android:label="Continuous Flow Prototype (debug)" />

        <!-- Wake-lock reliability fix (docs/specs/fold5-adaptation.md §4) -
             see ContinuousListeningService's own class doc for the full
             rationale. Not exported (only ConversationsFragment, in this
             same app process, ever starts/stops it); foregroundServiceType
             declared per Android 14's requirement (developer.android.com/
             about/versions/14/changes/fgs-types-required). -->
        <service
            android:name=".audio.ContinuousListeningService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Phone-side half of the watch6-classic-adaptation Data Layer API
             scaffold (docs/specs/watch6-classic-adaptation.md) - see
             PhoneWearSyncService's own class doc. exported=true is required
             for Google Play services (a separate process/app) to deliver
             Wearable MessageEvent intents to it; this is the standard
             pattern for WearableListenerService, not a general-purpose
             open component - the intent-filter below scopes it to only
             this app's own message path prefix. -->
        <service
            android:name=".wearsync.PhoneWearSyncService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/retroid" />
            </intent-filter>
        </service>
    </application>

</manifest>
