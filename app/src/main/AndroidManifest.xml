<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed only for the one-time ML Kit / Vosk / natural-voice (Piper via
         sherpa-onnx) language-pack downloads; all translation, speech
         recognition and speech synthesis after that runs fully offline,
         on-device, with no ongoing network dependency. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Mic capture for offline Vosk speech-to-text and for the Conversations /
         Practice recording features. Requested at runtime as well (dangerous
         permission). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Wake-lock reliability fix (docs/specs/fold5-adaptation.md §4): scoped
         to continuous-listening sessions backed by ContinuousListeningService
         (Conversations' continuous mode, and - as of the §4 "second surface"
         update - Translate's single_circle cover widget's own opt-in
         continuous toggle), acquired/released around each such session, never
         a blanket always-on lock for the app. WAKE_LOCK backs the PARTIAL_WAKE_LOCK that keeps the CPU
         scheduled for the mic-capture/VAD/dual-recognizer-decode threads
         through a screen lock; FOREGROUND_SERVICE + FOREGROUND_SERVICE_MICROPHONE
         are required by Android 14 (this project's targetSdk) to run a
         foreground service that keeps capturing microphone audio once the
         app is no longer in the foreground - without the microphone-typed
         foreground service, the OS can refuse to deliver mic audio at all
         once backgrounded, independent of any battery-management killing.
         POST_NOTIFICATIONS lets that foreground service's persistent
         "Listening for conversation..." notification actually display on
         Android 13+ (the service itself still runs without it, but the
         honest visible indicator - the whole reason a foreground service
         was chosen over a silent wake lock - would silently not show). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Camera OCR translate (docs/specs/fold5-adaptation.md "Camera OCR
         translate" section): single-shot capture only (CameraCaptureActivity
         takes one frame and runs on-device ML Kit Text Recognition on it,
         same "processes one frame, not a live stream" design already used
         nowhere else in this app but chosen for the same offline/no-cloud
         reasons everything else here is offline). Requested at runtime too
         (dangerous permission), same pattern MainActivity already uses for
         RECORD_AUDIO. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Declares this device needs a camera for the feature to be offered,
         but doesn't require ANY camera specifically (autofocus not assumed -
         the Retroid Pocket 2+'s camera hardware is weak/fixed-focus) and
         doesn't make the whole app uninstallable on a hypothetical
         camera-less device (required="false"). -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:name=".TranslatorApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.RetroidTranslator">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The three throwaway debug-prototype activities that used to live
             here (DualRecognizerProtoActivity, ContinuousFlowProtoActivity,
             OcrTestActivity - all docs/specs/fold5-adaptation.md §4/"Camera
             OCR translate" spike entry points) have moved to
             app/src/debug/AndroidManifest.xml, a debug-only Gradle source-set
             overlay. They needed android:exported="true" purely so
             `adb shell am start` could reach them for testing (Android 16
             blocks `adb shell am start` of a non-exported activity even in a
             debuggable app - see each Activity's own class doc), which meant
             they were reachable release-build attack surface for no shipped
             functionality. The debug source set is the idiomatic Android fix:
             the manifest merger includes these declarations only in debug
             builds, so they simply don't exist in a release APK/AAB at all,
             rather than existing-but-hopefully-unreachable. -->

        <!-- Throwaway debug entry point verifying the TranslationEngine.translate()
             Wi-Fi gating fix (docs/ENGINES.md Translation-engines "Known
             limits/gaps" #1) - see WifiGateTestActivity's own class doc for
             the full bug/fix explanation and trigger sequence. Same
             exported=true rationale as the other prototype activities above
             (Android 16 blocks `adb shell am start` of a non-exported
             activity even in a debuggable app). Not linked from any nav
             flow, off the launcher. -->
        <activity
            android:name=".prototype.WifiGateTestActivity"
            android:exported="true"
            android:label="Wi-Fi Gate Test (debug)" />

        <!-- Wake-lock reliability fix (docs/specs/fold5-adaptation.md §4) -
             see ContinuousListeningService's own class doc for the full
             rationale. Not exported (only ConversationsFragment, in this
             same app process, ever starts/stops it); foregroundServiceType
             declared per Android 14's requirement (developer.android.com/
             about/versions/14/changes/fgs-types-required). -->
        <service
            android:name=".audio.ContinuousListeningService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Camera OCR translate (docs/specs/fold5-adaptation.md "Camera OCR
             translate" section): reachable only from TranslateFragment's new
             camera button, launched via startActivityForResult and returning
             the recognized text as an Intent extra - not exported, no
             intent-filter, off the launcher, same "internal-only Activity"
             shape as this app's other non-launcher activities above. -->
        <activity
            android:name=".ocr.CameraCaptureActivity"
            android:exported="false"
            android:theme="@style/Theme.RetroidTranslator"
            android:screenOrientation="unspecified" />

        <!-- Phone-side half of the watch6-classic-adaptation Data Layer API
             scaffold (docs/specs/watch6-classic-adaptation.md) - see
             PhoneWearSyncService's own class doc. exported=true is required
             for Google Play services (a separate process/app) to deliver
             Wearable MessageEvent intents to it; this is the standard
             pattern for WearableListenerService, not a general-purpose
             open component - the intent-filter below scopes it to only
             this app's own message path prefix. -->
        <service
            android:name=".wearsync.PhoneWearSyncService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/retroid" />
            </intent-filter>
        </service>
    </application>

</manifest>
